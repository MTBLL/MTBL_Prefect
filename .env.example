PREFECT_API_URL=http://localhost:4200/api
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE
HEALTHCHECKS_PING_URL=https://hc-ping.com/REPLACE-ME

# Local Postgres target for the load step inside the runner container. The
# hostname `fantasy-pg` is a docker-compose service name — resolvable only
# from inside the compose network. Host-direct `uv run python -m mtbl_prefect ...`
# invocations need a different URL pointing at the fantasy-pg container via
# its published host port 5433 (see docker-compose.yml). Put the override in
# `.envrc.local` (gitignored), which `.envrc` sources AFTER this file so it
# wins. README §Host-direct setup walks through it; the line to add is:
#   export LOCAL_DATABASE_URL=postgresql://fantasy:fantasy@127.0.0.1:5433/fantasy_baseball
# (Use 127.0.0.1 not localhost — the host port is bound to the IPv4 loopback
#  only, and macOS's localhost resolution prefers IPv6 by default.)
LOCAL_DATABASE_URL=postgresql://fantasy:fantasy@fantasy-pg:5432/fantasy_baseball

# Note: Neon credentials live in the sub-project that uses them
# (_load/Player_Universe_Load/), not here. Each sub-project owns its own
# secrets; this .env is for orchestrator-scoped configuration only.
