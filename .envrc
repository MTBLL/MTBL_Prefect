# Load committed in-container defaults first, then layer a gitignored
# host-direct override on top. `.env` holds compose-network values
# (e.g. LOCAL_DATABASE_URL=...@fantasy-pg:5432/...); `.envrc.local`
# holds the host-direct equivalent (...@localhost:5433/...). See
# README §Host-direct setup for the exact contents to put in
# `.envrc.local`.
dotenv
source_env_if_exists .envrc.local
