<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mtbl.prefect.nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd /Users/Shared/BaseballHQ/tools/_orchestrate/MTBL_Prefect &amp;&amp; docker compose --profile runner run --rm runner full-pipeline --year $(date +%Y)</string>
    </array>

    <!-- Two runs per day, both America/Denver wall-clock. launchd fires on
         the system clock (TZ America/Denver), so both track the MDT/MST
         shift automatically and hold their local time year-round.

         00:16 — captures the prior day's completed games. Surfaces who to
                 target on waivers before claims process.
         09:05 — captures that day's waiver activity (claims clear at 09:00).
                 Post-waiver roster state is loaded in time to set lineups. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>16</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/Shared/BaseballHQ/logs/mtbl-prefect-nightly.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/BaseballHQ/logs/mtbl-prefect-nightly.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
