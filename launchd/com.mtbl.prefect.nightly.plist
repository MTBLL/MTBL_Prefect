<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mtbl.prefect.nightly</string>

    <!-- Docker preflight: Docker Desktop on macOS does NOT relaunch after a
         sleep/wake cycle, even with "Start at login" enabled. Without this
         block the launchd fire after a wake-from-sleep races a dead socket
         and exits 1 instantly. `open -ga Docker` is a no-op if it is already
         running, otherwise launches it; the poll then blocks (max 120s) until
         the daemon answers `docker info`. Exit code 2 distinguishes a
         preflight timeout from a pipeline failure (exit 1). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>open -ga Docker; for i in $(seq 1 60); do docker info &gt;/dev/null 2&gt;&amp;1 &amp;&amp; break; sleep 2; done; docker info &gt;/dev/null 2&gt;&amp;1 || { echo &quot;[preflight] Docker daemon not ready after 120s&quot; &gt;&amp;2; exit 2; }; cd /Users/Shared/BaseballHQ/tools/_orchestrate/MTBL_Prefect &amp;&amp; docker compose --profile runner run --rm runner full-pipeline --year $(date +%Y)</string>
    </array>

    <!-- Two runs per day, both America/Denver wall-clock. launchd fires on
         the system clock (TZ America/Denver), so both track the MDT/MST
         shift automatically and hold their local time year-round.

         00:16 — captures the prior day's completed games. Surfaces who to
                 target on waivers before claims process.
         09:05 — captures that day's waiver activity (claims clear at 09:00).
                 Post-waiver roster state is loaded in time to set lineups. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>16</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/Shared/BaseballHQ/logs/mtbl-prefect-nightly.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/BaseballHQ/logs/mtbl-prefect-nightly.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
